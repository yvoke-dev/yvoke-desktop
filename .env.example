# ==============================================================================
# Yvoke Desktop — Environment Variables Template
# Copy this file to .env or .env.local to configure local developer settings.
# ==============================================================================

# Google AI Studio Gemini API key for automated demo video voice narration
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Gemini model used for voice narration (default: gemini-3.1-flash-tts-preview)
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview

